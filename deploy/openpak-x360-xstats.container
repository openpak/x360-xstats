# PRIMARY host. OpenPak Xbox 360 leaderboards (x360-xstats): Live service 7 XRL requests the
# security gateway tunnels to the primary's Traefik. Identity headers are trusted only with the
# gateway key.
[Unit]
Description=OpenPak Xbox 360 leaderboards (x360-xstats)
Wants=openpak-leaderboards.service
After=openpak-leaderboards.service

[Container]
ContainerName=openpak-x360-xstats
Image=ghcr.io/openpak/x360-xstats:latest
AutoUpdate=registry
Network=openpak.network
IP=10.89.2.201
Environment=X360_XSTATS_ADDR=:10007
Environment=X360_XSTATS_STATE=/var/lib/x360-xstats/stats.json
# db.env defines X360_XSTATS_DATABASE_URL (Postgres, schema x360_xstats; required), mode 0600, never committed.
EnvironmentFile=%h/openpak/deploy/x360-xstats/db.env
EnvironmentFile=%h/openpak/deploy/x360-gateway-key.env
# X360_XSTATS_ARB_KEY / X360_XARB_ARB_KEY (one shared secret): lets xarb vouch for a result's participants. Mode 0600, never committed.
EnvironmentFile=%h/openpak/deploy/x360-arb-key.env
# X360_XSTATS_LEADERBOARDS_ADDR / X360_XSTATS_LEADERBOARDS_KEY (the leaderboards core; required), mode 0600, never committed.
EnvironmentFile=%h/openpak/deploy/x360-xstats/lb.env
# X360_XSTATS_ACCOUNT_CORE_URL / X360_XSTATS_ACCOUNT_CORE_TOKEN (gamertags), mode 0600, never committed.
EnvironmentFile=%h/openpak/deploy/x360-xstats/core.env
EnvironmentFile=%h/openpak/deploy/x360-xuacs-internal.env
Volume=%h/openpak/deploy/x360-xstats/state:/var/lib/x360-xstats:rw,Z
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
UserNS=keep-id:uid=100,gid=101

[Service]
Restart=always

[Install]
WantedBy=default.target
